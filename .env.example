# Copy this file to .env. Only the API key is required.
# Get one at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Every comment is on a line of its own: Docker's --env-file reads each
# KEY=value literally, so a trailing comment or quotes would become part
# of the value.

# Optional settings. Every value below is the default; see config.py.
# SUPPORT_BOT_MAIN_MODEL=claude-sonnet-5-5
# SUPPORT_BOT_HELPER_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
# SUPPORT_BOT_MAIN_EFFORT=low
# SUPPORT_BOT_HELPER_EFFORT=low
# SUPPORT_BOT_MAIN_MAX_TOKENS=4096
# SUPPORT_BOT_HELPER_MAX_TOKENS=2048
# loop | graph (the LangGraph variant)
# SUPPORT_BOT_AGENT_IMPL=loop
# SUPPORT_BOT_MAX_STEPS=8
# hybrid | lexical | dense
# SUPPORT_BOT_RETRIEVAL_MODE=hybrid
# BM25 share of ceiling
# SUPPORT_BOT_RELEVANCE_FLOOR=0.15
# cosine similarity, a noise gate
# SUPPORT_BOT_DENSE_FLOOR=0.50
# SUPPORT_BOT_CANDIDATES=6
# SUPPORT_BOT_TOP_K=3
# rank-fusion constant, from the sweep in reports/
# SUPPORT_BOT_RRF_K=20
# SUPPORT_BOT_USE_RERANK=true
# cache the system prompt, tools and conversation
# SUPPORT_BOT_PROMPT_CACHING=true
# SUPPORT_BOT_VERIFY_ANSWERS=true
# SUPPORT_BOT_CHECK_CITATIONS=true
# SUPPORT_BOT_REQUIRE_EVIDENCE=true
# local | hash (hash: no model, tests only)
# SUPPORT_BOT_EMBEDDER=local
# SUPPORT_BOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# where the embedding model is downloaded to
# SUPPORT_BOT_MODEL_CACHE=.models
# on-disk vector index (Qdrant local mode)
# SUPPORT_BOT_INDEX_PATH=.index
# set to use a Qdrant server instead of index_path
# SUPPORT_BOT_QDRANT_URL=
# DEBUG | INFO | WARNING | ERROR
# SUPPORT_BOT_LOG_LEVEL=INFO
# json | text (text: one readable line per turn)
# SUPPORT_BOT_LOG_FORMAT=json
# e.g. logs/turns.jsonl: also append every turn there (in the container,
# a path on a mounted volume, such as /logs/turns.jsonl)
# SUPPORT_BOT_TURN_LOG_PATH=
# true logs the customer's words and the answer
# SUPPORT_BOT_LOG_CONTENT=false
# the API refuses longer messages before any model call
# SUPPORT_BOT_MAX_MESSAGE_CHARS=2000
# an idle API conversation is dropped after this
# SUPPORT_BOT_SESSION_TTL_MINUTES=30
# the oldest conversation goes first beyond this
# SUPPORT_BOT_MAX_SESSIONS=1000
# a conversation this long must be restarted
# SUPPORT_BOT_MAX_TURNS=50
